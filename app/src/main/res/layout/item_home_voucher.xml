<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="236dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0.5dp"
    app:rippleColor="@color/primary_soft"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/llMiniStub"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_voucher_stub_primary"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/tvMiniBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="-15%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvMiniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                tools:text="Giảm 15% tối đa 25K" />

            <TextView
                android:id="@+id/tvMiniCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="Đơn từ 50.000 ₫" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMiniClaim"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_discount_solid"
            android:fontFamily="@font/be_vietnam_pro_semibold"
            android:gravity="center"
            android:minWidth="50dp"
            android:paddingHorizontal="9dp"
            android:textColor="@color/white"
            android:textSize="11.5sp"
            tools:text="Lưu" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
