<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Edge-to-Edge Studio Hero Gallery with Floating Back & Cart Controls -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="@color/bg_card">

                <ImageView
                    android:id="@+id/imgDetailProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Hình ảnh sản phẩm"
                    android:paddingHorizontal="32dp"
                    android:paddingTop="56dp"
                    android:paddingBottom="24dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Quay lại"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <FrameLayout
                    android:id="@+id/btnToolbarCart"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:contentDescription="@string/nav_cart"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav_cart"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvToolbarCartBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_pill_subtle"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Còn hàng"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_hairline" />

            <!-- TikTok Shop / Shopee Price-First Header Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp">

                <!-- Bold Coral Price + Strikethrough + Discount Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:letterSpacing="-0.02"
                        android:text="19.990.000 ₫"
                        android:textColor="@color/primary"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/tvDetailOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="22.990.000 ₫"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDetailDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_discount_tag"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="-13%"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Mall Tag + Brand & Category -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_freeship_tag"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="Chính hãng"
                        android:textColor="@color/teal_trust"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDetailBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Apple"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDetailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Điện thoại"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Product Name -->
                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:lineSpacingMultiplier="1.25"
                    android:text="iPhone 15 128GB"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <!-- Rating Jump Bar -->
                <LinearLayout
                    android:id="@+id/rowRatingJump"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="36dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/star_amber" />

                    <TextView
                        android:id="@+id/tvHeaderRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="4.8"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvHeaderReviewCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="(3 đánh giá)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/be_vietnam_pro_medium"
                        android:text="Xem đánh giá"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shipping & Warranty Assurance Block (Authentic TikTok Shop / Shopee Section) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_freeship_tag"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:text="Freeship"
                        android:textColor="@color/teal_trust"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Miễn phí vận chuyển cho đơn từ 5.000.000 ₫"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/teal_trust" />

                    <TextView
                        android:id="@+id/tvWarrantySummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Bảo hành chính hãng, đổi trả dễ dàng trong 15 ngày"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Product Description Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="@string/section_description"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Technical Specifications Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:text="@string/section_specs"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/llSpecsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Customer Reviews Section -->
            <LinearLayout
                android:id="@+id/sectionReviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReviewsTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="@string/section_reviews"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/btnWriteReview"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_discount_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@string/btn_write_review"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Rating Summary Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_product_img_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRatingAverage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="0.0"
                            android:textColor="@color/primary"
                            android:textSize="32sp" />

                        <LinearLayout
                            android:id="@+id/llAverageStars"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/tvRatingTotalCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 đánh giá"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="76dp"
                        android:layout_marginHorizontal="14dp"
                        android:background="@color/border_light" />

                    <LinearLayout
                        android:id="@+id/llRatingBars"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupReviewFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/tvEmptyReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="24dp"
                    android:text="@string/empty_reviews"
                    android:textColor="@color/text_muted"
                    android:textSize="13.5sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <!-- Iconic TikTok Shop / Shopee Split Bottom Bar (Tinted Blush Add + Solid Coral Buy Now) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số lượng"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvSelectedSubtotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="19.990.000 ₫"
                android:textColor="@color/primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_product_img_box"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnQtyMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Giảm số lượng"
                    android:padding="11dp"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvQuantity"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp" />

                <ImageButton
                    android:id="@+id/btnQtyPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tăng số lượng"
                    android:padding="11dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                style="@style/Widget.BtDay4.TintedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/btn_add_to_cart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyNow"
                style="@style/Widget.BtDay4.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.15"
                android:text="@string/btn_buy_now" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
