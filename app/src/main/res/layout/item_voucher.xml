<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardVoucherRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal">

            <!-- Left Die-Cut Ticket Stub -->
            <LinearLayout
                android:id="@+id/llVoucherStub"
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_voucher_stub_primary"
                android:gravity="center"
                android:minHeight="104dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/tvVoucherBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="0.95"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="-15%" />

                <TextView
                    android:id="@+id/tvVoucherCodeStub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    tools:text="TECHNEW15" />
            </LinearLayout>

            <!-- Ticket Details Body -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tvVoucherTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    tools:text="Giảm 15% đơn công nghệ" />

                <TextView
                    android:id="@+id/tvVoucherCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.25"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Giảm tối đa 25.000 ₫ cho đơn từ 50.000 ₫" />

                <TextView
                    android:id="@+id/tvVoucherMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro_medium"
                    android:maxLines="1"
                    android:textColor="@color/teal_trust"
                    android:textSize="11.5sp"
                    tools:text="Đủ điều kiện · Giảm 25.000 ₫" />
            </LinearLayout>

            <!-- Action Area (48dp touch height) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:paddingEnd="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVoucherAction"
                    style="@style/Widget.BtDay4.PrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:minHeight="36dp"
                    android:minWidth="74dp"
                    android:paddingHorizontal="12dp"
                    android:textSize="12.5sp"
                    app:cornerRadius="10dp"
                    tools:text="Lưu mã" />
            </FrameLayout>
        </LinearLayout>

        <!-- Perforated Ticket Punch-Outs on Seam (x = 82dp) -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="82dp"
            android:layout_marginTop="-6dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="@color/bg_screen" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="82dp"
            android:layout_marginBottom="-6dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="@color/bg_screen" />
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
