<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVoucher"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="0.75dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="106dp"
        android:orientation="horizontal">

        <!-- Left Ticket Stub -->
        <LinearLayout
            android:id="@+id/llVoucherStub"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_voucher_stub_left"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvVoucherValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:text="-10%"
                android:textColor="@color/white"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvVoucherCodeStub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.92"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="TECH10"
                android:textColor="@color/white"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Right Details & Actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/tvVoucherDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVoucherMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVoucherExpiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_semibold"
                    android:textColor="@color/teal_trust"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnCopyVoucher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_subtle"
                    android:fontFamily="@font/nunito_bold"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Sao chép"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnUseVoucher"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_popup_cta_pill"
                    android:fontFamily="@font/nunito_bold"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Dùng ngay"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
