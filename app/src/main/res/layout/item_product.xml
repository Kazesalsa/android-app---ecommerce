<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1.5dp"
    app:rippleColor="@color/primary_soft"
    app:strokeColor="@color/divider_hairline"
    app:strokeWidth="0.75dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Studio Product Image Stage with Floating Solid Coral Discount Pill -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@color/bg_image_stage"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Hình ảnh sản phẩm"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_discount_solid"
                android:fontFamily="@font/nunito_extrabold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="-13%"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Structured Commerce Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:lineSpacingMultiplier="1.22"
                android:lines="2"
                android:text="iPhone 15 128GB"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />

            <!-- Dynamic Trust Tags Row (Freeship / Brand) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFreeshipTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_freeship_tag"
                    android:fontFamily="@font/nunito_bold"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="Freeship"
                    android:textColor="@color/teal_trust"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvProductBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Apple"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Signature Coral Price + Strikethrough Original Price -->
            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:text="199.900 ₫"
                android:textColor="@color/primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvProductOriginalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="229.900 ₫"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <!-- Rating & Stock Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/star_amber" />

                <TextView
                    android:id="@+id/tvProductRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="4.8"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvProductReviewCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:text="(3)"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvProductStockMini"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Còn 18"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
