<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:rippleColor="@color/primary_soft"
    app:strokeColor="@color/divider_hairline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Studio Pedestal Image Stage (#F6F7FB) Separating Product Photo from Card Body -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="158dp"
            android:background="@color/bg_image_stage"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Hình ảnh sản phẩm"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvDiscountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_discount_solid"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="-13%"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvSoldOutOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_subtle"
                android:backgroundTint="@color/scrim_sold_out"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="@string/out_of_stock"
                android:textColor="@color/white"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Clean Balanced Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProductBrand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    tools:text="APPLE" />

                <TextView
                    android:id="@+id/tvLowStockTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_subtle"
                    android:backgroundTint="@color/warning_bg"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:textColor="@color/warning_amber"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Còn 3" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_semibold"
                android:lineSpacingMultiplier="1.2"
                android:lines="2"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                tools:text="iPhone 16 Pro Max 256GB" />

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:maxLines="1"
                android:textColor="@color/primary"
                android:textSize="16sp"
                tools:text="344.900 ₫" />

            <TextView
                android:id="@+id/tvProductOriginalPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                tools:text="349.900 ₫" />

            <!-- Rating + Quick Add-to-Cart Button Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgRatingStar"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/star_amber" />

                <TextView
                    android:id="@+id/tvProductRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="4.8" />

                <TextView
                    android:id="@+id/tvProductReviewCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    tools:text="(12)" />

                <FrameLayout
                    android:id="@+id/btnQuickAddCart"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="-4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Thêm nhanh vào giỏ"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_avatar"
                        android:backgroundTint="@color/ink_dark">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_add"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
