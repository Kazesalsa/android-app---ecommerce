<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardInAppBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="10dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <FrameLayout
            android:id="@+id/flBannerIconBg"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_avatar"
            android:backgroundTint="@color/teal_trust_bg">

            <ImageView
                android:id="@+id/imgBannerIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_nav_bell_filled"
                app:tint="@color/teal_trust" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:maxLines="1"
                android:text="Thông báo"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvBannerMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnBannerAction"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_discount_tag"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnBannerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng thông báo"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
