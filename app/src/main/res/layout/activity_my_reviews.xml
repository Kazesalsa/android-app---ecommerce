<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/myReviewsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMyReviews"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/my_reviews_title"
        app:titleCentered="true"
        app:titleTextColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMyReviews"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressMyReviews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_soft" />

        <LinearLayout
            android:id="@+id/llMyReviewsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="@color/primary_soft">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_outline"
                    app:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/be_vietnam_pro_bold"
                android:text="Chưa có đánh giá nào"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/be_vietnam_pro_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="Chia sẻ trải nghiệm thực tế trên các sản phẩm đã mua để giúp cộng đồng mua sắm tốt hơn."
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMyReviewsExplore"
                style="@style/Widget.BtDay4.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:minHeight="46dp"
                android:paddingHorizontal="24dp"
                android:text="Khám phá sản phẩm" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
