<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/edit_profile_title"
        app:titleCentered="true"
        app:titleTextColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- 1. Avatar Studio Card (Gallery Picker + 6 Curated Presets) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <FrameLayout
                        android:id="@+id/flEditAvatarPreview"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:clickable="true"
                        android:contentDescription="Chọn ảnh đại diện từ máy"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_button"
                            android:padding="3dp">

                            <TextView
                                android:id="@+id/tvEditAvatarInitials"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_circle_avatar"
                                android:backgroundTint="@color/ink_dark"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:gravity="center"
                                android:textColor="@color/white"
                                android:textSize="24sp"
                                tools:text="TT" />

                            <ImageView
                                android:id="@+id/imgEditAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_circle_avatar"
                            android:backgroundTint="@color/primary">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_camera"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickGalleryAvatar"
                            style="@style/Widget.BtDay4.TintedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:minHeight="40dp"
                            android:paddingHorizontal="14dp"
                            android:text="Chọn ảnh từ máy"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnClearAvatar"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="Dùng chữ cái"
                            android:textColor="@color/text_muted"
                            android:textSize="12.5sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Hoặc chọn nhanh bộ Avatar TechStore"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/llAvatarPresets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/presetAvatar1"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 1"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_1" />

                        <ImageView
                            android:id="@+id/presetAvatar2"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 2"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_2" />

                        <ImageView
                            android:id="@+id/presetAvatar3"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 3"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_3" />

                        <ImageView
                            android:id="@+id/presetAvatar4"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 4"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_4" />

                        <ImageView
                            android:id="@+id/presetAvatar5"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 5"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_5" />

                        <ImageView
                            android:id="@+id/presetAvatar6"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginHorizontal="3dp"
                            android:background="@drawable/bg_circle_button"
                            android:clickable="true"
                            android:contentDescription="Avatar mẫu 6"
                            android:focusable="true"
                            android:padding="2dp"
                            android:src="@drawable/ic_avatar_preset_6" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Personal Information Form Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEditName"
                        style="@style/Widget.BtDay4.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Họ và tên">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:minHeight="52dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEditEmail"
                        style="@style/Widget.BtDay4.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Email liên hệ">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:minHeight="52dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEditPhone"
                        style="@style/Widget.BtDay4.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Số điện thoại"
                        app:helperText="Dùng để xác nhận giao hàng nhanh">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:minHeight="52dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Gender Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="Giới tính"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGenderMale"
                            style="@style/Widget.BtDay4.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nam" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGenderFemale"
                            style="@style/Widget.BtDay4.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nữ" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipGenderOther"
                            style="@style/Widget.BtDay4.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khác" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Inline 3-Field Birth Date -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:text="Ngày sinh"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBirthDay"
                            style="@style/Widget.BtDay4.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="Ngày">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBirthDay"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="2"
                                android:maxLines="1"
                                android:minHeight="50dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBirthMonth"
                            style="@style/Widget.BtDay4.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="Tháng">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBirthMonth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="2"
                                android:maxLines="1"
                                android:minHeight="50dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBirthYear"
                            style="@style/Widget.BtDay4.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.35"
                            android:hint="Năm">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBirthYear"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="4"
                                android:maxLines="1"
                                android:minHeight="50dp"
                                android:textColor="@color/text_primary"
                                android:textSize="14.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBirthDateError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/danger_red"
                        android:textSize="12.5sp"
                        android:visibility="gone" />

                    <!-- Default Shipping Address -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEditAddress"
                        style="@style/Widget.BtDay4.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Địa chỉ giao hàng mặc định"
                        app:helperText="Tự động điền sẵn khi bạn bấm thanh toán">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEditAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textPostalAddress|textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:textColor="@color/text_primary"
                            android:textSize="14.5sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <LinearLayout
        android:id="@+id/llEditProfileBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            style="@style/Widget.BtDay4.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_save" />
    </LinearLayout>

</LinearLayout>
