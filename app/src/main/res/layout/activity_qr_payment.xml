<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qrPaymentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarQrPayment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/text_primary"
        app:title="@string/qr_payment_title"
        app:titleCentered="true"
        app:titleTextColor="@color/text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/llQrLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/primary_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:text="Đang tạo mã VietQR qua PayOS..."
            android:textColor="@color/text_primary"
            android:textSize="15.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/be_vietnam_pro_regular"
            android:gravity="center"
            android:text="Vui lòng giữ kết nối mạng trong giây lát"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Error / Expired Inline State -->
    <LinearLayout
        android:id="@+id/llQrError"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0.5dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:backgroundTint="@color/primary_soft">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr_code"
                        app:tint="@color/primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvQrErrorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:gravity="center"
                    android:text="Không thể tạo mã QR"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp" />

                <TextView
                    android:id="@+id/tvQrErrorMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/be_vietnam_pro_regular"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.35"
                    android:text="Vui lòng kiểm tra kết nối Wi-Fi hoặc thử lại."
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryQr"
                    style="@style/Widget.BtDay4.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:text="Tạo lại mã QR" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewOrderFromError"
                    style="@style/Widget.BtDay4.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Xem chi tiết đơn hàng" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Active QR Payment Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollQrContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/qrContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Live Polling Status & Countdown Strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_trust_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/teal_trust" />

                <TextView
                    android:id="@+id/tvQrStatusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/be_vietnam_pro_semibold"
                    android:text="Đang tự động kiểm tra thanh toán..."
                    android:textColor="@color/teal_trust"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tvQrCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_discount_solid"
                    android:fontFamily="@font/be_vietnam_pro_bold"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp"
                    android:text="15:00"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Centerpiece VietQR Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_freeship_tag"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="VietQR · PayOS"
                            android:textColor="@color/teal_trust"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvQrOrderCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/be_vietnam_pro_medium"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="DH-20261124-0000"
                            android:textColor="@color/text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Framed High-Contrast QR Bitmap -->
                    <FrameLayout
                        android:layout_width="236dp"
                        android:layout_height="236dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_qr_frame"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/imgQrCode"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Mã VietQR thanh toán đơn hàng"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:text="Số tiền cần thanh toán"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvQrAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/be_vietnam_pro_bold"
                        android:text="0 ₫"
                        android:textColor="@color/primary"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvQrVoucherNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_freeship_tag"
                        android:fontFamily="@font/be_vietnam_pro_semibold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/teal_trust"
                        android:textSize="11.5sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/be_vietnam_pro_regular"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.35"
                        android:text="Mở ứng dụng Ngân hàng hoặc Ví điện tử hỗ trợ VietQR và quét mã phía trên để thanh toán tự động."
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Collapsible Manual Transfer Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowToggleManualTransfer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="54dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:text="Thông tin chuyển khoản thủ công"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Sao chép STK &amp; nội dung nếu không quét được QR"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvToggleManualLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/be_vietnam_pro_semibold"
                            android:text="Mở rộng"
                            android:textColor="@color/primary"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llManualTransferDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/divider_hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Ngân hàng"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvQrBankName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/divider_hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Chủ tài khoản"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvQrAccountName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/divider_hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Số tài khoản"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvQrAccountNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/btnCopyAccount"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_copy_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Sao chép"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/divider_hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Số tiền"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvQrTransferAmount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:textColor="@color/primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/btnCopyAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_copy_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Sao chép"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/divider_hairline" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/be_vietnam_pro_regular"
                                android:text="Nội dung CK"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvQrDescription"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/be_vietnam_pro_bold"
                                android:textColor="@color/text_primary"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/btnCopyDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_copy_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/be_vietnam_pro_semibold"
                                android:gravity="center"
                                android:paddingHorizontal="12dp"
                                android:text="Sao chép"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/be_vietnam_pro_regular"
                            android:text="Giữ nguyên số tiền và nội dung chuyển khoản để PayOS tự động đối soát."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inline 2-Step Cancel Payment Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelPayment"
                    style="@style/Widget.BtDay4.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Hủy giao dịch thanh toán QR"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/llCancelConfirmBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0.5dp"
                    app:strokeColor="@color/danger_red"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/be_vietnam_pro_bold"
                            android:text="Xác nhận hủy giao dịch QR và đơn hàng này?"
                            android:textColor="@color/danger_red"
                            android:textSize="13.5sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnKeepPayment"
                                style="@style/Widget.BtDay4.SecondaryButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="Giữ lại" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConfirmCancelPayment"
                                style="@style/Widget.BtDay4.PrimaryButton"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:text="Xác nhận hủy"
                                app:backgroundTint="@color/danger_red" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/dividerQrBottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline"
        android:visibility="gone" />

    <!-- Elevated Sticky Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/llQrBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPayOsWeb"
            style="@style/Widget.BtDay4.TintedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.9"
            android:text="Mở PayOS"
            android:textSize="14sp"
            app:icon="@drawable/ic_open_external"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckStatus"
