<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:orientation="vertical">

    <!-- Elevated Flagship Mall Header (Brand Strip + Coral-Framed Search Pill + Live Cart) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Compact Brand & Greeting Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_discount_solid"
                android:fontFamily="@font/nunito_extrabold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="MALL"
                android:textColor="@color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="1"
                android:text="Xin chào"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvProductCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_subtle"
                android:fontFamily="@font/nunito_semibold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="0 sản phẩm"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Pinned Shopee / TikTok Shop Coral-Framed Search Pill + Quick Cart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill_accent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Xóa tìm kiếm"
                    android:padding="9dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- Quick Cart Action with Live Badge -->
            <FrameLayout
                android:id="@+id/btnHomeCart"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/nav_cart"
                android:focusable="true">

                <ImageView
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_cart"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvHomeCartBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Store Feed -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- Category Strip -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_card"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Elevated Flagship Spotlight Card (Hidden during search/filter) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpotlight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ink_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_banner"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:orientation="vertical"
                        android:paddingEnd="12dp">

                        <TextView
                            android:id="@+id/tvSpotlightBrand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_freeship_tag"
                            android:fontFamily="@font/nunito_extrabold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Chính hãng"
                            android:textColor="@color/teal_trust"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/tvSpotlightName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunito_extrabold"
                            android:letterSpacing="-0.02"
                            android:maxLines="2"
                            android:textColor="@color/white"
                            android:textSize="17.5sp" />

                        <TextView
                            android:id="@+id/tvSpotlightSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.78"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvSpotlightPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_discount_solid"
                                android:fontFamily="@font/nunito_bold"
                                android:paddingHorizontal="11dp"
                                android:paddingVertical="4dp"
                                android:text="Mua ngay"
                                android:textColor="@color/white"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="106dp"
                        android:layout_height="106dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgSpotlight"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Sản phẩm nổi bật"
                            android:padding="8dp"
                            android:scaleType="fitCenter" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Floating Mall Assurance Strip -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/rowTrustStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="0.75dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/teal_trust" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="Chính hãng 100%"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/teal_trust" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1.05"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="Freeship từ 50K"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/teal_trust" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="Đổi trả 15 ngày"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shopee / Lazada / TikTok Shop 4-Tab Sort Bar (Inline, Zero Popup) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@color/bg_card"
                android:elevation="0.5dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabSortDefault"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSortDefault"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_bold"
                        android:gravity="center"
                        android:text="Liên quan"
                        android:textColor="@color/primary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indSortDefault"
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="@color/primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabSortRating"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSortRating"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:text="Đánh giá"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indSortRating"
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="@color/primary"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabSortPriceAsc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSortPriceAsc"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:text="Giá thấp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indSortPriceAsc"
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="@color/primary"
                        android:visibility="invisible" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabSortPriceDesc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSortPriceDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_semibold"
                        android:gravity="center"
                        android:text="Giá cao"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <View
                        android:id="@+id/indSortPriceDesc"
                        android:layout_width="34dp"
                        android:layout_height="2.5dp"
                        android:background="@color/primary"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2-Column Commerce Product Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="10dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="56dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/empty_products"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thử tìm từ khóa khác hoặc đặt lại bộ lọc."
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetFilter"
                    style="@style/Widget.BtDay4.TintedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/clear_filter"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
