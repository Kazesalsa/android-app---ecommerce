<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- Crisp Product Photography Stage -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Hình ảnh sản phẩm"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvDiscountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_discount_tag"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="-13%"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_hairline" />

    <!-- Structured TikTok Shop / Shopee Card Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_medium"
            android:lineSpacingMultiplier="1.22"
            android:lines="2"
            android:text="iPhone 15 128GB"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <!-- Dynamic Trust Tags Row (Freeship / Chính hãng) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFreeshipTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_freeship_tag"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="Freeship"
                android:textColor="@color/teal_trust"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProductBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Apple"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Signature Commerce Coral-Red Price -->
        <TextView
            android:id="@+id/tvProductPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_bold"
            android:maxLines="1"
            android:text="19.990.000 ₫"
            android:textColor="@color/primary"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/tvProductOriginalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="22.990.000 ₫"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />

        <!-- Rating & Stock Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/star_amber" />

            <TextView
                android:id="@+id/tvProductRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/be_vietnam_pro_medium"
                android:text="4.8"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvProductReviewCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:text="(3)"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvProductStockMini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Còn hàng"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
